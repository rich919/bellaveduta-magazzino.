# Copia questo file in .env.local e riempi i valori.
# .env.local è in .gitignore: non finirà mai nel repository.

# ─── Modalità dell'applicazione ────────────────────────────────────────────
# Lo stesso codice viene distribuito come due progetti Vercel distinti.
#
#   site   (default)  espone solo il sito pubblico. /gestionale risponde 404.
#   admin             espone solo il gestionale, protetto da login.
#                     Le rotte pubbliche rispondono 404.
#
# È così che il gestionale sta su un indirizzo diverso da quello delle clienti.
APP_MODE=site

# ─── Accesso al gestionale (serve solo con APP_MODE=admin) ─────────────────
#
# DEMO SENZA PASSWORD
# Con questa a 1 il gestionale si apre a chiunque abbia il link, e compare un
# avviso ben visibile in cima alla pagina. Serve a far vedere la dashboard alla
# titolare senza passarle credenziali, e va bene finché i dati sono inventati.
# APPENA CI FINISCONO APPUNTAMENTI VERI VA TOLTA.
GESTIONALE_SENZA_PASSWORD=1

# Con GESTIONALE_SENZA_PASSWORD tolta, queste due tornano obbligatorie in
# produzione: senza, l'applicazione si rifiuta di partire.
# Genera AUTH_SECRET con:  openssl rand -base64 32
ADMIN_PASSWORD=
AUTH_SECRET=

# ─── Generazione immagini (solo in locale, mai su Vercel) ──────────────────
# Serve unicamente per lanciare `npm run immagini`. Le foto vengono scaricate
# e committate in public/images, quindi in produzione questa chiave non serve.
KIE_API_KEY=
